# strata-xtx: welke variant dit is. Bepaalt namen en paden, zodat varianten naast elkaar in één container passen.
XTX_NAME=strata-xtx-rocm10              # service-, config-, log- en state-naam
CMD_PREFIX=xtx10                        # commando's in /usr/local/bin: xtx10-update, xtx10-bench, ...
STRATA_DIR_DEFAULT=/opt/ai/strata-rocm10 # eigen clone van upstream met een eigen .venv (ROCm 10)
ROCM_VERSION_DEFAULT=latest:10          # nieuwste ROCm 10.x-wheel van AMD's gfx110X-dgpu-index, vastgezet bij installatie
CONFLICTS=strata-xtx                    # de ROCm 7-variant gebruikt dezelfde GPU en poort: nooit tegelijk

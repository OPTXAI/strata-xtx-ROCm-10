# strata-xtx: welke variant dit is. Bepaalt namen en paden, zodat varianten naast elkaar in één container passen.
XTX_NAME=strata-xtx-rocm10              # service-, config-, log- en state-naam
CMD_PREFIX=xtx10                        # commando's in /usr/local/bin: xtx10-update, xtx10-bench, ...
STRATA_DIR_DEFAULT=/opt/ai/strata-rocm10 # eigen clone van upstream
ROCM_SOURCE_DEFAULT=apt                 # ROCm 10 staat niet op de pip-index: systeem-ROCm uit AMD's apt-repo
ROCM_APT_DEFAULT=latest                 # nieuwste 10.x voor gfx1100 bij installatie, daarna vast (ROCM_APT= in xtx.conf)
CONFLICTS="strata-xtx strata-xtx-rocm714"           # andere varianten op dezelfde GPU/poort (nooit tegelijk)
